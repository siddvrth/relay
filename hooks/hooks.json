{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh UserPromptSubmit",
            "statusMessage": "Checking relay threshold"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh PreToolUse",
            "statusMessage": "Checking relay write authority"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh PreCompact",
            "statusMessage": "Writing relay checkpoint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh Stop",
            "statusMessage": "Preserving relay state"
          }
        ]
      }
    ]
  }
}
