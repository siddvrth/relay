{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh UserPromptSubmit",
            "statusMessage": "Checking relay threshold"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh PreToolUse",
            "statusMessage": "Checking Relay context and write authority"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/relay_hook.sh SessionEnd",
            "statusMessage": "Cleaning Relay workers"
          }
        ]
      }
    ]
  }
}
